{
	"schemaVersion": 1,
	"id": "cryptic",
	"version": "${version}",
	"name": "Cryptic",
	"description": "A Hypixel SkyBlock mod: dungeon solvers, Floor 7 tools, Crystal Hollows helpers and everyday QoL in one menu.",
	"authors": [
		"iMicro"
	],
	"contact": {
		"homepage": "https://modworks.tf/cryptic",
		"sources": "https://github.com/WhyiMicro/cryptic",
		"issues": "https://github.com/WhyiMicro/cryptic/issues"
	},
	"license": "LicenseRef-Cryptic-Non-Commercial",
	"icon": "assets/cryptic/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "imicro.cryptic.Cryptic",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "imicro.cryptic.CrypticClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"cryptic.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
